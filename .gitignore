# ============================================
# 원본 데이터 (KOSSDA 이용약관상 재배포 금지)
# ============================================
*.sav
*.dta
*.por
*.zip

# ============================================
# 파생 데이터 (원본 복원 가능하므로 동일 취급)
# ============================================
inventory/*
selection/*
export/*
probe/*

!inventory/diagnostics.md
!selection/codebook_ab.md
!probe/README.md
!probe/contamination_result.md

# ============================================
# 토큰화/오염 프로브 진단 (모델별 .md만 추적, 다른 산출물은 재생성)
# ============================================
token_check/*
!token_check/*.md

# ============================================
# LLM 응답 캐시 / API 키
# ============================================
cache/
*.sqlite
*.db
.env
.env.*
secrets.*
*api_key*

# ============================================
# 파이썬
# ============================================
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.ruff_cache/

# ============================================
# 편집기 / OS
# ============================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# Excel 임시 파일
# ============================================
~$*.xlsx
~$*.docx

codebook_raw.txt
selection/
*.pdf
/사전스터디
